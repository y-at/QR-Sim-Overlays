<UserControl x:Class="QRO.Views.GraphicsPresetSelectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="600">
    <Grid  Style="{StaticResource BackgroundAppColour}">
        <Border Style="{StaticResource CardStyle}" Margin="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Graphics Presets"
                           Style="{StaticResource SectionHeaderStyle}"/>

                <!-- VR / Monitor toggle -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <RadioButton Content="Monitor"
                                 IsChecked="{Binding IsMonitorMode, Mode=OneWay}"
                                 VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <RadioButton Content="VR"
                                 IsChecked="{Binding IsVrMode}"
                                 VerticalAlignment="Center"/>
                    <ComboBox Visibility="{Binding IsVrMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                              ItemsSource="{Binding VrRenderModeCollection}"
                              SelectedItem="{Binding SelectedVrRenderMode}"
                              MinWidth="120"
                              Margin="16,0,10,0"/>

                    <TextBlock Text="{Binding GameFileName, StringFormat='  ({0})'}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedForegroundBrush}" FontStyle="Italic"/>
                </StackPanel>

                <!-- Save new preset -->
                <TextBlock Grid.Row="2"
                           Text="{Binding ModeLabel, StringFormat='Save current {0} settings file as a new preset:'}"
                           Margin="0,0,0,4"/>

                <Grid Grid.Row="3" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,8,0"/>
                    <Button Grid.Column="1"
                            Content="Save as Preset"
                            Command="{Binding SaveCommand}"/>
                </Grid>

                <!-- Presets list -->
                <ListBox Grid.Row="4"
                         ItemsSource="{Binding Presets}"
                         SelectedItem="{Binding SelectedFilePreset}"
                         DisplayMemberPath="Name"
                         Margin="0,0,0,12"/>

                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="Load Selected"
                            Command="{Binding LoadCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="Delete Selected"
                            Command="{Binding DeleteCommand}"/>
                </StackPanel>

                <TextBlock Grid.Row="6"
                           Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           FontStyle="Italic"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
