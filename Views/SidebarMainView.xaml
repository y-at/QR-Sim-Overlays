<UserControl x:Class="QRO.Views.SidebarMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QRO.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid Grid.Column="0" Width="65" Style="{StaticResource ConnectionStatusGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
            </Grid.ColumnDefinitions>

                <!-- Navigation Buttons -->
            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" Margin="5, 15, 5, 15">
                    
                            <!-- Overlays Button -->
                    <Button Content="Overlays" Click="OverlayButton_Click" ToolTip="Overlays" Margin="0,0,0,5"
                            Style="{StaticResource OverlaysNavButtonStyle}"/>

                    <!-- Controls Presets Button -->
                    <Button Content="Controls presets" Click="ControlsPresetsButton_Click" Margin="0,5"
                            Style="{StaticResource ControlsPresetsNavButtonStyle}"/>

                    <!-- Graphics Presets Button -->
                    <Button Content="Graphics presets" Click="GraphicsPresetsButton_Click" Margin="0,5"
                            Style="{StaticResource GraphicsPresetsNavButtonStyle}"/>

                    <!-- Race Engineer Button -->
                    <Button Content="Race engineer" Click="RaceEngineerButton_Click" Margin="0,5"
                            Style="{StaticResource RaceEngineerNavButtonStyle}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Theme toggle + GitHub buttons -->
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="5">
                <Button ToolTip="Toggle light / dark theme"
                        Command="{Binding ToggleThemeCommand}"
                        Style="{StaticResource ThemeToggleButtonStyle}"
                        Content="🌓"
                        Margin="0,0,0,5"/>

                <Button ToolTip="Visit GitHub Repository" Click="GitHubButton_Click" Style="{StaticResource NavButtonStyle}">
                    <Image Source="/Resources/Images/GitHub_Dark.png" Margin="6" />
                </Button>
            </StackPanel>
            <Grid Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource ConnectionStatusGridStyle}"/>
        </Grid>
    </Grid>
</UserControl>
