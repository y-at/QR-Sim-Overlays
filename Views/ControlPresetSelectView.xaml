<UserControl x:Class="QRO.Views.ControlPresetSelectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="600">
    <Grid Style="{StaticResource BackgroundAppColour}">
        <Border Style="{StaticResource CardStyle}" Margin="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Control Presets"
                           Style="{StaticResource SectionHeaderStyle}"/>

                <!-- Currently loaded profile -->
                <Border Grid.Row="1"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,8"
                        Margin="0,0,0,16">
                    <TextBlock Text="{Binding LoadedPresetStatus}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                </Border>

                <TextBlock Grid.Row="2"
                           Text="Save current controls.cfg as a new preset:"
                           Margin="0,0,0,4"/>

                <Grid Grid.Row="3" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,8,0"/>
                    <Button Grid.Column="1"
                            Content="Save as Preset"
                            Command="{Binding SaveCommand}"/>
                </Grid>

                <!-- Presets list -->
                <ListBox Grid.Row="4"
                         ItemsSource="{Binding Presets}"
                         SelectedItem="{Binding SelectedFilePreset}"
                         DisplayMemberPath="Name"
                         Margin="0,0,0,12"/>

                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="Load Selected"
                            Command="{Binding LoadCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="Rename Selected"
                            Command="{Binding RenameCommand}"
                            ToolTip="Renames the selected preset to the name entered in the box above."
                            Margin="0,0,8,0"/>
                    <Button Content="Delete Selected"
                            Command="{Binding DeleteCommand}"/>
                </StackPanel>

                <TextBlock Grid.Row="6"
                           Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           FontStyle="Italic"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
